{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "functions": {
    "backend/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,tests/**,docs/**,n8n/**,scripts/**,.venv/**,data/*.db}"
    }
  }
}
